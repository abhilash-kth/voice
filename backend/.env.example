# ============================================================================
# Voice Agent SaaS — environment template
# Copy to `.env` and fill in the values. NEVER commit a filled-in .env.
# Values shown below without "=" blanks are the code defaults (safe to omit).
# ============================================================================

# ----------------------------- Database / Auth -----------------------------
# MySQL (or Prisma-compatible) connection string
DATABASE_URL=

# JWT secret for dashboard sessions — CHANGE in production
JWT_SECRET=
# minutes a dashboard login stays valid (default 43200 = 30 days)
ACCESS_TOKEN_MINUTES=43200

# ----------------------------- LiveKit server ------------------------------
# Your self-hosted LiveKit deployment
LIVEKIT_URL=wss://kvoice.duckdns.org
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP trunk used for outbound campaigns (leave blank for browser testing only)
SIP_TRUNK_ID=
ALLOW_BROWSER_CALL=true
# LiveKit cloud noise cancellation (Krisp) — "true" if enabled on your server
NOISE_CANCELLATION=true
# worker processes kept warm to answer calls instantly
NUM_IDLE_PROCESSES=2

# ------------------------------- STT / TTS ---------------------------------
# Deepgram (STT) — deepgram console key. Nova-3, multilingual incl. hi-IN.
DEEPGRAM_API_KEY=

# Google Cloud (Chirp 3 HD voices TTS + Gemini live STT) — path to the
# service-account JSON. Also re-used by Google TTS credentials prewarm.
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json

# ------------------------------ LLM providers ------------------------------
# OpenAI — voice-suitable models only (gpt-4.1-mini/nano, gpt-4o-mini,
# gpt-5-mini/nano, gpt-5.4-mini/nano). Per-agent selection happens in the
# dashboard; these are only the process-wide defaults.
OPENAI_API_KEY=
OPENAI_MODEL=

# Groq — current free-tier, non-deprecated models (openai/gpt-oss-120b/20b,
# openai/gpt-oss-safeguard-20b, qwen/qwen3.6-27b, llama-4-maverick-17b-128e,
# moonshotai/kimi-k2-instruct-0905, MiniMax M2.7)
GROQ_API_KEY=
GROQ_MODEL=

# Google Gemini — gemini-2.5-flash-lite (recommended for voice) / 2.5-flash.
# Either variable works; GEMINI_API_KEY takes precedence.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Sarvam AI — LLM (sarvam-30b/-16k/105b), Bulbul v3/v2 TTS, Saaras v3 STT.
# Billing in INR. Get a key at dashboard.sarvam.ai
SARVAM_API_KEY=

# Fallback adapter: seconds a primary LLM may stay unavailable before the
# secondary takes over (default 8). Lower = switches faster per interactive
# turn.
VOICE_LLM_FALLBACK_DELAY=8

# --------------------------- Billing / pricing -----------------------------
# Billing micro-service (Fastify) that proxies Razorpay + wallet logic
BILLING_BACKEND_URL=http://localhost:3001
BILLING_INTERNAL_TOKEN=
# ₹ floor charged per provider minute, infra cost estimate and margin
MIN_CLIENT_PRICE=1.00
SERVER_COST_PER_MIN=0.05
PROFIT_MARGIN_PERCENT=50
# JSON array of recharge options shown in the dashboard (₹)
WALLET_TOPUP_AMOUNTS=[100, 250, 500, 1000]

# ---------------------------- Recording / egress ---------------------------
EGRESS_ENABLED=false
EGRESS_PUBLIC_BASE_URL=
EGRESS_S3_ENDPOINT=
EGRESS_S3_REGION=
EGRESS_S3_BUCKET=
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=

# --------------------------------- API server ------------------------------
PORT=8000
LOG_LEVEL=INFO
# campaign scheduler tick + zombie-call sweeper
CAMPAIGN_TICK_SECONDS=15
STALE_CALL_MINUTES=15
STALE_CALL_POLL_SECONDS=60

# ============================================================================
# VOICE TUNING — human-like turn-taking. These ARE the shipped defaults;
# override only after measuring real calls (all values seconds unless noted).
# ============================================================================

# Turn detection: "stt" (Deepgram end-of-turn) — keep for Indic languages
VOICE_TURN_DETECTION=stt
# Dead-air before/after which the agent may start replying (market standard)
VOICE_ENDPOINTING_MIN=0.35
VOICE_ENDPOINTING_MAX=0.75

# Barge-in: user speech must last this long AND contain this many words
# before the agent is interrupted (stops breaths/clicks killing playback)
VOICE_ALLOW_INTERRUPTIONS=true
VOICE_MIN_INTERRUPTION_DURATION=0.5
VOICE_MIN_INTERRUPTION_WORDS=2

# Silero VAD
VOICE_VAD_MIN_SPEECH=0.20
VOICE_VAD_MIN_SILENCE=0.35
VOICE_VAD_PREFIX_PADDING=0.20
VOICE_VAD_THRESHOLD=0.55

# Deepgram end-of-speech (ms) / utterance-end (ms) — aligned with the
# endpointing values above so STT and VAD never fight.
VOICE_STT_ENDPOINTING_MS=300
VOICE_STT_UTTERANCE_END_MS=800

# Generative first reply while user is still finishing — keep OFF with RAG
# enabled (prevents duplicate generations)
VOICE_PREEMPTIVE=false
VOICE_PREEMPTIVE_TTS=false

# OpenAI responses-API websocket mode (0 = classic chat completions; keeps
# prompt_cache_key working). Enable only after testing with your provider.
VOICE_USE_RESPONSES_API=0

# --------------------------- Prompt-size budgets ---------------------------
# Characters injected per request — protects Groq free-tier TPM / latency.
VOICE_KB_BUDGET_CHARS=800
VOICE_FAQ_BUDGET_CHARS=400
VOICE_OWNER_PROMPT_BUDGET_CHARS=2000
VOICE_PRIOR_MEMORY_BUDGET_CHARS=800
# Re-run RAG for every new user turn (true) vs. reuse of turn-0 context
VOICE_RAG_PER_TURN=true

# ------------------------- Advanced / diagnostics --------------------------
# Bound the CPython thread pools used by the LiveKit plugins (leave default)
# VOICE_THREAD_LIMITS=
# Custom CA bundle locations (httpx honors these when set)
# SSL_CERT_FILE=
# SSL_CERT_DIR=
