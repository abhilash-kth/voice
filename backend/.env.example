DATABASE_URL
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=

# Google Cloud service-account JSON for Chirp 3 HD voices TTS (+ live STT)
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json

# Cartesia — Sonic TTS (ultra-low-latency WebSocket streaming, sonic-3/sonic-2,
# 40+ languages incl. Hindi). Free tier at https://play.cartesia.ai
CARTESIA_API_KEY=

# ----------------------------- LLM providers --------------------------------
# Customers pick models in the dashboard; these keys just unlock the providers.
OPENAI_API_KEY=        # gpt-4.1-mini/nano, gpt-4o-mini, gpt-5-mini/nano, gpt-5.4-mini/nano
GROQ_API_KEY=          # gpt-oss-120b/20b/safeguard-20b, qwen3.6-27b, maverick, kimi-k2 … (free tier)
GEMINI_API_KEY=        # gemini-2.5-flash-lite (voice pick) / gemini-2.5-flash
# GOOGLE_API_KEY=      # alias also accepted for Gemini
SARVAM_API_KEY=        # sarvam-30b/105b LLM, Bulbul v3/v2 TTS, Saaras STT (INR)

# Seconds a primary LLM may stay down before the per-agent fallback model
# takes over (default 8).
VOICE_LLM_FALLBACK_DELAY=6

# ------------------------------- Auth ---------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=10080

# ------------------------- Billing / platform -------------------------------
# Pricing floor + margin applied on top of measured provider cost
MIN_CLIENT_PRICE=1.00
SERVER_COST_PER_MIN=0.05
PROFIT_MARGIN_PERCENT=50
# Recharge options shown on the wallet page (₹)
WALLET_TOPUP_AMOUNTS=[100, 250, 500, 1000]
# Optional external billing micro-service (Fastify). Blank = built-in wallet.
BILLING_BACKEND_URL=http://localhost:3001
BILLING_INTERNAL_TOKEN=

PORT=8000
LOG_LEVEL=INFO

# --------------------------- Recording / egress -----------------------------
# Set EGRESS_ENABLED=false unless S3 is fully configured.
EGRESS_ENABLED=false
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_TTS_MODEL=
OPENAI_API_KEY=OYnCGPSJlWyWiuP1rprCulN3_uzAqJdwPMY1gA
GOOGLE_APPLICATION_CREDENTIALS=
VOICE_LLM_FALLBACK_DELAY=
VOICE_PREEMPTIVE=
VOICE_TURN_DETECTION=
VOICE_ENDPOINTING_MIN=
VOICE_ENDPOINTING_MAX=
EGRESS_ENABLED=
EGRESS_S3_BUCKET=
EGRESS_S3_ENDPOINT=
EGRESS_S3_REGION=

