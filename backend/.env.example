# ============================================================================
# Voice Agent SaaS — operator environment
#
# Copy to `.env` and fill in YOUR values. `.env` is gitignored — never commit it.
#
# IMPORTANT: this file only contains infrastructure + API keys.
# Customers choose provider / model / language / gender / voice PER AGENT in
# the dashboard — there is no global model setting to configure here.
# ============================================================================

# ------------------------------- Database -----------------------------------
# PostgreSQL (Neon / RDS / any PG). Prisma schema is provider = "postgresql".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ------------------------------- LiveKit ------------------------------------
LIVEKIT_URL=wss://your-livekit-domain
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# optional: number of worker processes kept warm to answer calls instantly
# NUM_IDLE_PROCESSES=2

# ------------------------------ Telephony -----------------------------------
# SIP trunk for outbound/campaign calls (blank while doing browser testing)
SIP_TRUNK_ID=

# --------------------------- STT / TTS providers ----------------------------
# STATIC_SECRET: master fallback API keys. Per-provider keys stored in the
# Super Admin panel (ProviderCredential, encrypted at rest) take precedence —
# env keys only apply when no DB credential exists.
#
# Deepgram — speech-to-text (default STT; Nova-3, multilingual incl. hi-IN)
DEEPGRAM_API_KEY=

# Google Cloud service-account JSON for Chirp 3 HD voices TTS (+ live STT)
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json

# Cartesia — Sonic TTS (ultra-low-latency WebSocket streaming, sonic-3/sonic-2,
# 40+ languages incl. Hindi). Free tier at https://play.cartesia.ai
CARTESIA_API_KEY=

# Optional TTS providers (disabled by default; enable in Super Admin → Providers)
ELEVENLABS_API_KEY=    # ElevenLabs Multilingual TTS
FISH_AUDIO_API_KEY=    # Fish Voice (Fish Audio) — OpenAI-compatible TTS endpoint
MINIMAX_API_KEY=       # MiniMax Voice — OpenAI-compatible TTS endpoint

# ----------------------------- LLM providers --------------------------------
# Customers pick models in the dashboard; these keys just unlock the providers.
# STATIC_SECRET: master fallback keys (DB credentials override when present).
OPENAI_API_KEY=        # gpt-4.1-mini/nano, gpt-4o-mini, gpt-5-mini/nano, gpt-5.4-mini/nano
GROQ_API_KEY=          # gpt-oss-120b/20b/safeguard-20b, qwen3.6-27b, maverick, kimi-k2 … (free tier)
GEMINI_API_KEY=        # gemini-2.5-flash-lite (voice pick) / gemini-2.5-flash
# GOOGLE_API_KEY=      # alias also accepted for Gemini
SARVAM_API_KEY=        # sarvam-30b/105b LLM, Bulbul v3/v2 TTS, Saaras STT (INR)
ANTHROPIC_API_KEY=     # Claude models (native plugin; disabled by default)
QWEN_API_KEY=          # Alibaba Qwen (DashScope; disabled by default)

# Seconds a primary LLM may stay down before the per-agent fallback model
# takes over (default 8).
VOICE_LLM_FALLBACK_DELAY=6

# ------------------------------- Auth ---------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=10080

# SUPER_ADMIN_SETUP_KEY: one-time key protecting POST /api/setup/super-admin,
# the ONLY way to create the FIRST Super Admin. Callers send it in the
# `X-Setup-Key` request header. Two safety gates: (1) this key must match,
# (2) it works only while ZERO super admins exist — afterwards the endpoint
# is permanently closed (later admins are promoted from Super Admin -> Users).
# Leave BLANK to disable the endpoint entirely (production recommendation:
# set it, create your first admin, then blank it out again).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPER_ADMIN_SETUP_KEY=

# STATIC_SECRET: Super-Admin credential encryption key (Fernet). Any credential
# (provider API keys) stored through the Super Admin panel is encrypted with
# this BEFORE touching the DB. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DO NOT rotate without re-encrypting existing rows (rotation helper:
# ADMIN_CONFIG_ENC_KEYS supports multiple ids; last id is the primary).
ADMIN_CONFIG_ENC_KEY=
# ADMIN_CONFIG_ENC_KEYS='{"k1": "<old-key>", "k2": "<new-key>"}'

# ------------------------- Billing / platform -------------------------------
# STATIC defaults — applied once at first boot to seed BillingConfig; the
# Super Admin panel edits afterwards. Changing env afterwards has NO effect
# once the DB row exists (use Super Admin → Billing).
MIN_CLIENT_PRICE=1.00
SERVER_COST_PER_MIN=0.05
PROFIT_MARGIN_PERCENT=50
# Wallet top-up options (₹) — DYNAMIC, Super Admin → Billing
WALLET_TOPUP_AMOUNTS=[100, 250, 500, 1000]
# Optional external billing micro-service (Fastify). Blank = built-in wallet.
BILLING_BACKEND_URL=http://localhost:3001
BILLING_INTERNAL_TOKEN=

PORT=8000
LOG_LEVEL=INFO

# --------------------------- Recording / egress -----------------------------
# Set EGRESS_ENABLED=false unless S3 is fully configured.
EGRESS_ENABLED=false
EGRESS_S3_BUCKET=
EGRESS_S3_ENDPOINT=https://s3.amazonaws.com
EGRESS_S3_REGION=us-east-1
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
# EGRESS_PUBLIC_BASE_URL=

# Campaign scheduler + zombie-call sweeper (safe defaults)
# CAMPAIGN_TICK_SECONDS=15
# STALE_CALL_MINUTES=15
# STALE_CALL_POLL_SECONDS=60

# ============================================================================
# VOICE TUNING — ALREADY TUNED FOR HUMAN-LIKE CONVERSATION.
# Leave these OUT of your .env unless call measurements force a change;
# the code ships with the values below as defaults.
#
# VOICE_TURN_DETECTION=stt          # Deepgram end-of-turn
# VOICE_ENDPOINTING_MIN=0.35        # dead-air before agent may reply
# VOICE_ENDPOINTING_MAX=0.75        # max wait after user pauses
# VOICE_MIN_INTERRUPTION_DURATION=0.5   # barge-in needs 0.5s AND
# VOICE_MIN_INTERRUPTION_WORDS=2        #   2 words -> breaths don't cut off
# VOICE_VAD_MIN_SPEECH=0.20
# VOICE_VAD_MIN_SILENCE=0.35
# VOICE_VAD_PREFIX_PADDING=0.20
# VOICE_VAD_THRESHOLD=0.55
# VOICE_STT_ENDPOINTING_MS=300
# VOICE_STT_UTTERANCE_END_MS=800
# VOICE_ALLOW_INTERRUPTIONS=true
# VOICE_PREEMPTIVE=false            # keep off when RAG is enabled
# VOICE_PREEMPTIVE_TTS=false
# VOICE_USE_RESPONSES_API=0
# VOICE_RAG_PER_TURN=true
# VOICE_KB_BUDGET_CHARS=800
# VOICE_FAQ_BUDGET_CHARS=400
# VOICE_OWNER_PROMPT_BUDGET_CHARS=2000
# VOICE_PRIOR_MEMORY_BUDGET_CHARS=800
# ============================================================================

# ── LEGACY / NOT USED — DELETE from your .env if present ────────────────────
# LLM_MODEL=            ← model ids like "google/gemma-4-31b-it:free" are
# LLM_TTS_MODEL=          OpenRouter-format leftovers; OpenRouter is removed
# OPENROUTER_API_KEY=     and customers choose models per agent in the UI.
# CLIENT_RATE_PER_MIN=  ← not read by this codebase (see MIN_CLIENT_PRICE +
#                           PROFIT_MARGIN_PERCENT above)

# --- Sessions / CORS (secure cookie auth) ---
# Browsers get the JWT only as an httpOnly cookie; set COOKIE_SECURE=1 when
# serving over HTTPS so the cookie is HTTPS-only.
COOKIE_SECURE=0
# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002
# --- Billing POST target for the worker (needed only if the API isn't :8000) ---
# BILLING_BACKEND_URL=http://127.0.0.1:9000
